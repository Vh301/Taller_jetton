{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": ["wrappers/**/*.ts", "lib/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "output/**/*.ts"]
}
