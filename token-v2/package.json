{
  "name": "taller-tlr-token-v2",
  "version": "0.1.0",
  "private": true,
  "description": "TALLER / TLR — Tact base fixed-supply jetton (sandbox + testnet/mainnet tooling)",
  "scripts": {
    "build": "tact --config ./tact.config.json --project TallerJetton",
    "test": "npm run build && jest tests/",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "mint:testnet": "tsx scripts/mint-testnet.ts",
    "close-minting:testnet": "tsx scripts/close-minting.ts",
    "revoke-owner:testnet": "tsx scripts/revoke-owner.ts",
    "check:stats": "tsx scripts/check-jetton-stats.ts",
    "emulate:post-close": "tsx scripts/emulate-post-close.ts",
    "emulate:after-owner-null": "tsx scripts/emulate-after-owner-null.ts",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "mint:mainnet": "tsx scripts/mint-mainnet.ts",
    "close-minting:mainnet": "tsx scripts/close-minting-mainnet.ts",
    "revoke-owner:mainnet": "tsx scripts/revoke-owner-mainnet.ts"
  },
  "dependencies": {
    "@ton/core": "^0.63.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@tact-lang/compiler": "1.6.7",
    "@ton/sandbox": "0.30.0",
    "@ton/test-utils": "^0.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
