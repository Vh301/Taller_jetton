# TALLER Poster Bot — env template
# Copy to taller_poster_bot/.env.local (poster bot service only — not taller_token/).
# Never commit .env.local.

# --- Telegram bot ---
TALLER_POSTER_BOT_API_TOKEN=
# alias: TALLER_POSTER_BOT_TOKEN, TELEGRAM_BOT_TOKEN

# Bot username (reference only)
# TALLER_POSTER_BOT=@TALLER_Post_bot

# Channel: t.me URL, @username, or numeric chat id
TALLER_CHANNEL=
# alias: TALLER_POSTER_CHANNEL, TALLER_TELEGRAM_CHANNEL_URL

# Comma-separated Telegram user IDs (empty = all admin actions denied)
TALLER_POSTER_ADMIN_USER_IDS=

# Webhook URL for setup script (after Vercel deploy)
TALLER_POSTER_WEBHOOK_URL=

# --- Supabase (project ref: kapundznmkfpeingstyu) ---
TALLER_POSTER_BOT_SUPABASE_URL=
TALLER_POSTER_BOT_SUPABASE_PASSWORD=
TALLER_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for poster bot DB (RPC) — must match poster_internal_config.api_secret
TALLER_POSTER_DB_SECRET=

# Optional — direct Postgres pooler (fallback when anon key unavailable on Vercel)
TALLER_SUPABASE_DATABASE_URL=

# Dev-only local polling override (tools/taller-poster-bot)
# ALLOW_LOCAL_POLLING=1
